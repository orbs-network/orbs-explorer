{
  "name": "orbs-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "pnpm --parallel --filter @orbs/explorer --filter @orbs/ops dev",
    "dev:explorer": "pnpm --filter @orbs/explorer dev",
    "dev:ops": "pnpm --filter @orbs/ops dev",
    "build": "pnpm --filter @orbs/explorer --filter @orbs/ops build",
    "build:explorer": "pnpm --filter @orbs/explorer build",
    "build:ops": "pnpm --filter @orbs/ops build",
    "lint": "eslint apps packages",
    "typecheck": "pnpm --filter @orbs/explorer --filter @orbs/ops typecheck",
    "test": "node --import tsx --test tests/*.test.ts",
    "deploy": "bash scripts/deploy-vercel.sh --app explorer",
    "deploy:preview": "bash scripts/deploy-vercel.sh --app explorer --preview",
    "deploy:prod": "bash scripts/deploy-vercel.sh --app explorer --prod",
    "deploy:explorer": "bash scripts/deploy-vercel.sh --app explorer",
    "deploy:ops": "bash scripts/deploy-vercel.sh --app ops",
    "screenshot": "node scripts/screenshot.mjs",
    "screenshot:install": "playwright install chromium",
    "screenshot:pr": "./scripts/pr-screenshots.sh",
    "screenshot:upload": "./scripts/screenshot-upload.sh",
    "start": "pnpm --filter @orbs/explorer start",
    "start:explorer": "pnpm --filter @orbs/explorer start",
    "start:ops": "pnpm --filter @orbs/ops start",
    "cron": "./scripts/run-cron.sh"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.59.1",
    "prettier": "^3.8.0",
    "tailwindcss": "^4",
    "tsx": "^4",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5",
    "next": "^16.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "viem": "^2.34.0",
    "axios": "^1.11.0",
    "@tanstack/react-query": "^5.85.5",
    "jose": "^6.1.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "volta": {
    "node": "22.23.1"
  }
}
