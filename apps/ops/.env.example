# Google sign-in is temporarily disabled in all environments. Set true to restore it.
OPS_REQUIRE_GOOGLE_AUTH=false
# With the gate restored, skip sign-in on localhost with next dev only.
# Ignored in production and Vercel.
OPS_LOCAL_AUTH_BYPASS=true
# Google OAuth web client; authorize the ops domain, http://localhost, and http://localhost:3004.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Generate independently per environment: openssl rand -hex 32
OPS_SESSION_SECRET=
OPS_GOOGLE_DOMAIN=orbs.com
NEXT_PUBLIC_RPC_URL=
# Operational credentials belong only in this app's Vercel project.
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
